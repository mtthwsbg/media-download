{
  "manifest_version": 3,
  "name": "Media Downloader",
  "version": "3.0.0",
  "description": "Save posts from any social app, sorted into folders, with a panel showing what is downloading.",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "storage",
    "contextMenus",
    "notifications",
    "activeTab",
    "tabs",
    "cookies"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Downloads",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.facebook.com/*",
    "*://*.youtube.com/*",
    "*://*.youtu.be/*",
    "*://*.tiktok.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.reddit.com/*",
    "*://*.redd.it/*",
    "*://*.snapchat.com/*",
    "*://*.bsky.app/*",
    "*://*.twitch.tv/*",
    "*://*.vimeo.com/*",
    "*://*.dailymotion.com/*",
    "*://*.streamable.com/*",
    "*://*.rumble.com/*",
    "*://*.kick.com/*",
    "*://*.bilibili.com/*",
    "*://*.vk.com/*",
    "*://*.weibo.com/*",
    "*://*.linkedin.com/*",
    "*://*.9gag.com/*",
    "*://*.newgrounds.com/*",
    "*://*.pinterest.com/*",
    "*://*.imgur.com/*",
    "*://*.flickr.com/*",
    "*://*.deviantart.com/*",
    "*://*.artstation.com/*",
    "*://*.pixiv.net/*",
    "*://*.tumblr.com/*",
    "*://*.tenor.com/*",
    "*://*.soundcloud.com/*",
    "*://*.bandcamp.com/*"
  ],
  "key": ""
}

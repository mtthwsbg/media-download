{
  "manifest_version": 3,
  "name": "Media Downloader",
  "version": "2.0.0",
  "description": "Queue up links from any tab and save them, plus a folder Claude can read.",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "notifications",
    "activeTab",
    "cookies"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Download this",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.facebook.com/*",
    "*://*.youtube.com/*",
    "*://*.tiktok.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.reddit.com/*"
  ],
  "key": ""
}
